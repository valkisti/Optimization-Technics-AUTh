clear;
syms x y;                                                                             

f = @(x1, x2) (1/3)*(x1.^2) + 3*(x2.^2);                         
e = 0.01;

[k,x1k,x2k] = steepest_descent_projection(f, 5, -5, e, 0.5, 5, -10, 5, -8, 12);
k
figure;
[X,Y]=meshgrid(-8:0.1:8);
%Z= X.^3 .* exp(-X.^2-Y.^4);
Z = (1/3).*(X.^2) + 3.*(Y.^2);
contour(X, Y, Z);
hold on;
plot(x1k, x2k, 'Color', 'r', 'Marker','o');
title({'Steepest Descent method','for constant g = 1','starting at (-1,-1)'})
xlabel('x1') 
ylabel('x2') 
grid on;

[k,x1k,x2k] = steepest_descent_projection(f, 5, -5, e, 0.1, 15, -10, 5, -8, 12);
k
figure;
[X,Y]=meshgrid(-8:0.1:8);
%Z= X.^3 .* exp(-X.^2-Y.^4);
Z = (1/3).*(X.^2) + 3.*(Y.^2);
contour(X, Y, Z);
hold on;
plot(x1k, x2k, 'Color', 'r', 'Marker','o');
title({'Steepest Descent method','for constant g = 1','starting at (-1,-1)'})
xlabel('x1') 
ylabel('x2') 
grid on;

[k,x1k,x2k] = steepest_descent_projection(f, 5, -5, e, 0.1, 5, -10, 5, -8, 12);
k
figure;
[X,Y]=meshgrid(-8:0.1:8);
%Z= X.^3 .* exp(-X.^2-Y.^4);
Z = (1/3).*(X.^2) + 3.*(Y.^2);
contour(X, Y, Z);
hold on;
plot(x1k, x2k, 'Color', 'r', 'Marker','o');
title({'Steepest Descent method','for constant g = 1','starting at (-1,-1)'})
xlabel('x1') 
ylabel('x2') 
grid on;