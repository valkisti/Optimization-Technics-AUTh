function fit = fitness(genes, genesNum)
    % fitnessFunc
    %
    % The score of each solution is calculated as the mean square error (mse)
    % of the approximation to the real value of the f used for input-output data.

    u1_limits = [-1 2];
    u2_limits = [-2 1];

    points = 25;

    % Generate a grid of u1 and u2 values
    [U1, U2] = meshgrid(linspace(u1_limits(1), u1_limits(2), points), linspace(u2_limits(1), u2_limits(2), points));

    % Evaluate real and approximated values on the entire grid
    realValues = test_f(U1, U2);
    approxValues = f_approx(U1, U2, genes, genesNum);

    % Calculate the mean square error (MSE)
    fit = mean((realValues - approxValues).^2, 'all');
end
