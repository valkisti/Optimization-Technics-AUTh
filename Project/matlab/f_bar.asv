function val = f_bar(u1Bar,u2Bar,genes,size)

% Function to calculate value for each Gaussian.

val = 0;
for i = 1:5:size
    A = genes(i);
    c1 = genes(i+1);
    c2 = genes(i+2);
    s1 = genes(i+3);
    s2 = genes(i+4);
    power = ((u1Bar-c1)^2/(2*s1^2)) + ((u2Bar-c2)^2/(2*s2^2));
    val = val + A * exp(-power);
end
end